# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartband?retryWrites=true&w=majority

# --- Auth ---
# Long random string (64+ chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Encryption for stored integration credentials (AES-256-GCM) ---
# 32 bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- AI providers (defaults; a guardian's saved AI config overrides these) ---
AI_PRIMARY=nvidia_nim
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Safety thresholds ---
HR_MIN=40
HR_MAX=130
DEVICE_OFFLINE_SECONDS=120
MED_MISSED_GRACE_MINUTES=60
# Timezone used for medicine schedule times (IANA name)
APP_TIMEZONE=Asia/Kolkata
